    </owl:Class>
    


    <!-- https://purl.org/s2c2/miscon#MilitaryEmployment -->

    <owl:Class rdf:about="https://purl.org/s2c2/miscon#MilitaryEmployment">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Relator"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="https://purl.org/s2c2/miscon#MilitaryPerson"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The Thruthmaker of the relationship between Military and Military Organization.</rdfs:comment>
        <rdfs:label>MilitaryEmployment</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/s2c2/miscon#MilitaryOrganization -->

    <owl:Class rdf:about="https://purl.org/s2c2/miscon#MilitaryOrganization">
        <rdfs:subClassOf rdf:resource="https://purl.org/s2c2/miscon#InstitutionalElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://purl.org/s2c2/miscon#MilitaryEmployment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType -->

    <owl:Class rdf:about="https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType">
        <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#EndurantType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/s2c2/miscon#MOTypeIsSubordinateTo"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>PowerType of MilitaryOrganization.</rdfs:comment>
        <rdfs:label>MilitaryOrganitionPowerType</rdfs:label>
    </owl:Class>
    


    <!-- https://purl.org/s2c2/miscon#MilitaryPerson -->

    <owl:Class rdf:about="https://purl.org/s2c2/miscon#MilitaryPerson">
        <rdfs:subClassOf rdf:resource="https://purl.org/s2c2/miscon#OperationalElement"/>
        <rdfs:subClassOf rdf:resource="https://purl.org/s2c2/miscon#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/s2c2/miscon#militaryPersonHasMilitaryOrganization"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="http://purl.org/nemo/gufo#mediates"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://purl.org/s2c2/miscon#MilitaryEmployment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- https://purl.org/s2c2/miscon#MilitaryPersonAsDismounted -->

