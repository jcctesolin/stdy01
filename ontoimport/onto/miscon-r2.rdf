    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotations
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#AccessPoint">
        <rdfs:comment>Device that receives the network signal (wired or wireless) and makes the Wi-Fi signal available to other electronic devices.</rdfs:comment>
        <rdfs:label xml:lang="en">AccessPoint</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Armored">
        <rdfs:comment>A subtype to specialize armored vehicles.</rdfs:comment>
        <rdfs:label xml:lang="en">Armored</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Battalion">
        <rdfs:comment>A subtype of military organization. A specialization for the Battalion level in the hierarchy of military organizations.</rdfs:comment>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#BattleGroup">
        <rdfs:comment>A subtype of military organization. A specialization for the BattleGroup level in the hierarchy of military organizations.</rdfs:comment>
        <rdfs:label>BattleGroup</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Brigade">
        <rdfs:comment>A subtype of military organization. A specialization for the Brigade level in the hierarchy of military organizations.</rdfs:comment>
        <rdfs:label>Brigade</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Cascavel">
        <rdfs:comment>Cascavel is a type of armored vehicle.</rdfs:comment>
        <rdfs:label>Cascavel</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#CommDevice">
        <rdfs:comment>Communication device used for communication.</rdfs:comment>
        <rdfs:label xml:lang="en">CommDevice</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#CommDeviceCarrier">
        <rdfs:comment>Carries the communication device and has the attributes of speed and visibility.</rdfs:comment>
        <rdfs:label xml:lang="en">CommDeviceCarrier</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Commander">
        <rdfs:comment>Role that a military organization assumes when occupying a commanding position in relation to another military organization in the military hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="en">Commander</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#CommanderMilitaryPerson">
        <rdfs:comment>Military Person who is commander of the other Military Persons in his MO</rdfs:comment>
        <rdfs:label>CommanderMilitaryPerson</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Company">
        <rdfs:comment>A subtype of military organization. A specialization for the Company level in the hierarchy of military organizations.</rdfs:comment>
        <rdfs:label>Company</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Guarani">
        <rdfs:comment>Guarani is a type of armored vehicle.</rdfs:comment>
        <rdfs:label>Guarani</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#HierarchicallyEquivalent">
        <rdfs:comment>Role that two distinct military organizations assume when they find themselves in a position of equivalence in the military hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="en">HierarchicallyEquivalent</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Interface">
        <rdfs:comment>Device connection point.</rdfs:comment>
        <rdfs:label xml:lang="en">Interface</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#MilitaryOrganization">
        <rdfs:comment>Type that confers a principle of identity to a given organization within the military domain. According to decree N 93,188, of August 29, 1986: Art 22. Units are military organizations called regiment, battalion or group. Art 23. Subunits are military organizations called company, squadron or battery and can be incorporated or independent.

According to the Army Glossary:

1. Generic name given to a troop unit, department, establishment, ship, base, arsenal or any other administrative, tactical or operational unit of the Armed Forces. 2. Army organizations that have their own official name, organizational structure and list of expected positions.</rdfs:comment>
        <rdfs:label xml:lang="en">MilitaryOrganization</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#MilitaryPerson">
        <rdfs:comment>Role of a person who has a military employment relationship with a military organization.</rdfs:comment>
        <rdfs:label xml:lang="en">MilitaryPerson</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#MilitaryPersonAsDismounted">
        <rdfs:comment>Role of the soldier who transports the device on foot.</rdfs:comment>
        <rdfs:label>MilitaryPersonAsDismounted</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#MilitaryPersonAsPassenger">
        <rdfs:comment>Role of the military person who is located in a vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">MilitaryPersonAsPassenger</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#MilitaryPlatform">
        <rdfs:comment>Carries a communication device. Its speed directly impacts the speed at which the device moves in network emulation. An example is vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">MilitaryPlatform</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#OperationalElement">
        <rdfs:comment>Set of operational elements that aggregate the scenario. Elements that are linked to practical and routine activities that are carried out to meet the institution&apos;s objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">OperationalElement</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Person">
        <rdfs:comment>A type that gives the principle of identity to human beings.</rdfs:comment>
        <rdfs:label xml:lang="en">Person</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Platoon">
        <rdfs:comment>A subtype of military organization. A specialization for the Platoon level in the hierarchy of military organizations.</rdfs:comment>
        <rdfs:label>Platoon</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Subordinate">
        <rdfs:comment>Role that a military organization assumes when it is directly subordinate to another organization in the hierarchy.</rdfs:comment>
        <rdfs:label xml:lang="en">Subordinate</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#SubordinateMilitaryPerson">
        <rdfs:comment>Military Person subordinate to CommanderMilitaryPerson, in the hierarchy of military personnel in a Military Organization</rdfs:comment>
        <rdfs:label>SubordinateMilitaryPerson</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Ue">
        <rdfs:comment>User Equipment. Interface usada para comunicação em diferentes níveis de hierarquia. Especializada em UeUp e UeDown.</rdfs:comment>
        <rdfs:label>Ue</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#UeDown">
        <rdfs:comment>Interface to talk with subordinate levels.</rdfs:comment>
        <rdfs:label>UeDown</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#UeInternDown">
        <rdfs:comment>Interface used for communication by the CommanderMilitary to his subordinates.</rdfs:comment>
        <rdfs:label>UeInternDown</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#UeOperator">
        <rdfs:label xml:lang="en">CommDeviceOperator</rdfs:label>
        <rdfs:label>UeOperator</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#UeUp">
        <rdfs:comment>Interface to talk with commander levels.</rdfs:comment>
        <rdfs:label>UeUp</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Urutu">
        <rdfs:comment>Urutu is a type of armored vehicle.</rdfs:comment>
        <rdfs:label>Urutu</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#Vehicle">
        <rdfs:comment>Platform type. It has a principle of identity due to the fact that each vehicle is unique and has a chassis number.</rdfs:comment>
        <rdfs:label xml:lang="en">Vehicle</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#WirelessNetwork">
        <rdfs:comment>The wireless communication network.</rdfs:comment>
        <rdfs:label xml:lang="en">WirelessNetwork</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="https://purl.org/s2c2/miscon#militaryPersonHasMilitaryOrganization">
        <rdfs:comment>A relationship that establishes that a military person has a military organization.</rdfs:comment>
        <rdfs:label>militaryPersonHasMilitaryOrganization</rdfs:label>
    </rdf:Description>
    


