<?xml version="1.0"?>
<rdf:RDF xmlns="https://purl.org/s2c2/miscon#"
     xml:base="https://purl.org/s2c2/miscon"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:gufo="https://purl.org/nemo/gufo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:gufo1="http://purl.org/nemo/gufo#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://purl.org/s2c2/miscon">
        <owl:imports rdf:resource="https://raw.githubusercontent.com/jcctesolin/stdy01/dev/ontoimport/onto/gufo-o.owl"/>
        <rdfs:comment>The MiScOn ontology presents modeling that connects the military environment with the communication environment, reusing other ontologies, providing semantic reasoning with information about the behavior of communication between military personnel in an operational scenario.

The MiScOn ontology represents concepts related to the Brazilian Armed Forces, but represents concepts in English. Therefore, if necessary, the translation can be done easily using translation tools or dictionaries. With the correct translation, the terms represented should not present interoperability problems with the terms used by the Armed Forces&apos; C2 systems.</rdfs:comment>
        <rdfs:label>MiScOn - Military Scenario Ontology</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/nemo/gufo#categorizes -->

    <owl:AnnotationProperty rdf:about="http://purl.org/nemo/gufo#categorizes"/>
    


    <!-- http://purl.org/nemo/gufo#isDerivedFrom -->

    <owl:AnnotationProperty rdf:about="http://purl.org/nemo/gufo#isDerivedFrom"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/nemo/gufo#inheresIn -->

    <owl:ObjectProperty rdf:about="http://purl.org/nemo/gufo#inheresIn">
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#CommDeviceCarrier"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/nemo/gufo#mediates -->

    <owl:ObjectProperty rdf:about="http://purl.org/nemo/gufo#mediates"/>
    


    <!-- https://purl.org/s2c2/miscon#MOPTIsSubordinateTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#MOPTIsSubordinateTo"/>
    


    <!-- https://purl.org/s2c2/miscon#MOPowerTypeIsSubordinateTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#MOPowerTypeIsSubordinateTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType"/>
        <rdfs:comment>A relationship that establishes that a MOPowerType is subordinate to another MOPowerType.</rdfs:comment>
        <rdfs:label>MOPowerTypeIsSubordinateTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#MOTypeIsSubordinateTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#MOTypeIsSubordinateTo"/>
    


    <!-- https://purl.org/s2c2/miscon#ProtocolOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#ProtocolOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#inheresIn"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Protocol"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#belongsTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#belongsTo">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryPlatform"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
        <rdfs:comment>A relationship that establishes that a military platform belongs to a military organization.</rdfs:comment>
        <rdfs:label>belongsTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#carries -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#carries">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#CommDeviceCarrier"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#CommDevice"/>
        <rdfs:comment>A relationship that establishes that a person carries a commdevice.</rdfs:comment>
        <rdfs:label xml:lang="en">carries</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#hasDirectRelationshipWith -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hasDirectRelationshipWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
        <rdfs:comment>A relationship that establishes that a military organization has a direct relationship with another military organization.</rdfs:comment>
        <rdfs:label xml:lang="en">hasDirectRelationshipWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#hasInterfPowerType -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hasInterfPowerType">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:label>hasInterfPowerType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#hasInterface -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hasInterface">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#CommDevice"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:comment>A relationship that establishes that a commdevice has an interface.</rdfs:comment>
        <rdfs:label xml:lang="en">hasInterface</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#hasMOPowerType -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hasMOPowerType">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganizationPowerType"/>
        <rdfs:comment>A relationship that establishes that a military organization has a military organization power type.</rdfs:comment>
        <rdfs:label>hasMOPowerType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#hasVehiclePowerType -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hasVehiclePowerType"/>
    


    <!-- https://purl.org/s2c2/miscon#hierarchicallyEquivalentWith -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#hierarchicallyEquivalentWith">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#HierarchicallyEquivalent"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#HierarchicallyEquivalent"/>
        <rdfs:comment>A relationship that establishes that a military organization is hierarchically equivalent to another military organization.</rdfs:comment>
        <rdfs:label xml:lang="en">HierarchicallyEquivalentWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#isCommanderOf -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#isCommanderOf">
        <owl:inverseOf rdf:resource="https://purl.org/s2c2/miscon#isSubordinateTo"/>
        <rdfs:comment>A relationship that establishes that a military organization is commander of another military organization,</rdfs:comment>
        <rdfs:label xml:lang="pt">isCommanderOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#isLocatedIn -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#isLocatedIn">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryPersonAsPassenger"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Vehicle"/>
        <rdfs:comment>A relationship that establishes that a passenger is located in a vehicle.</rdfs:comment>
        <rdfs:label xml:lang="en">isLocatedIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#isSubordinateTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#isSubordinateTo">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Subordinate"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Commander"/>
        <rdfs:comment>A relationship that establishes that a military organization is subordinate to another military organization.</rdfs:comment>
        <rdfs:label xml:lang="en">isSubordinateTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#mayTalkTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#mayTalkTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Ue"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Ue"/>
        <rdfs:comment>A relationship that establishes that an interface may talk to another interface.</rdfs:comment>
        <rdfs:label>mayTalkTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#militaryPersonHasMilitaryOrganization -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#militaryPersonHasMilitaryOrganization">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryPerson"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#militaryPersonIsSubordinateTo -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#militaryPersonIsSubordinateTo">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#SubordinateMilitaryPerson"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#CommanderMilitaryPerson"/>
        <rdfs:comment>A relationship that defines the relationship of subordination between two military persons from the same MO</rdfs:comment>
        <rdfs:label>militaryPersonIsSubordinateTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#militaryScenarioHasInstitutionalElement -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#militaryScenarioHasInstitutionalElement">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryScenario"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#InstitutionalElement"/>
        <rdfs:comment>A relationship that establishes that a military scenario has an institutional element.</rdfs:comment>
        <rdfs:label>militaryScenarioHasInstitutionalElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#militaryScenarioHasOperationalElement -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#militaryScenarioHasOperationalElement">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryScenario"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#OperationalElement"/>
        <rdfs:comment>A relationship that establishes that a military scenario has an operational element.</rdfs:comment>
        <rdfs:label>militaryScenarioHasOperationalElement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#networkHasInterface -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#networkHasInterface">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#WirelessNetwork"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:comment>A relationship that establishes that a WirelessNetwork has an interface.</rdfs:comment>
        <rdfs:label>networkHasInterface</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://purl.org/s2c2/miscon#operates -->

    <owl:ObjectProperty rdf:about="https://purl.org/s2c2/miscon#operates">
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#UeOperator"/>
        <rdfs:range rdf:resource="https://purl.org/s2c2/miscon#Ue"/>
        <rdfs:comment>A relationship that establishes that a person operates an User equipment.</rdfs:comment>
        <rdfs:label xml:lang="en">operates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/nemo/gufo#hasQualityValue -->

    <owl:DatatypeProperty rdf:about="http://purl.org/nemo/gufo#hasQualityValue"/>
    


    <!-- https://purl.org/s2c2/miscon#amphibiousSpeed -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#amphibiousSpeed">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Armored"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Amphibious speed is an attribute of armored vehicles that have the ability to move on water.</rdfs:comment>
        <rdfs:label>amphibiousSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#antennaGain -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#antennaGain">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Interface antenna gain.</rdfs:comment>
        <rdfs:label>antennaGain</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#channelValue -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#channelValue">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#AccessPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Channel used at the access point.</rdfs:comment>
        <rdfs:label>channelValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#coverage -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#coverage">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Communication device coverage to share data with other devices. In Mininet-WiFi it is equivalent to the range attribute.</rdfs:comment>
        <rdfs:label>coverage.</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#frequency -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#frequency">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Frequency used by interface type.</rdfs:comment>
        <rdfs:label>frequency</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#frequencyRange -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#frequencyRange">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Range of frequency values.</rdfs:comment>
        <rdfs:label>frequencyRange</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#ip -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#ip">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Interface"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ip address of interface.</rdfs:comment>
        <rdfs:label>ip</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#mac -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#mac">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#CommDevice"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>mac address of commdevice.</rdfs:comment>
        <rdfs:label>mac</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#maxPassengers -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#maxPassengers">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#Vehicle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Max capacity of passengers in a vehicle.</rdfs:comment>
        <rdfs:label>maxPassengers</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#maxSpeedLand -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#maxSpeedLand">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#CommDeviceCarrier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Max speed of a vehicle on land.</rdfs:comment>
        <rdfs:label>maxSpeedLand</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#maxStrength -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#maxStrength">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Max strength of a military organization.</rdfs:comment>
        <rdfs:label>maxStrength</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#minPassengers -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#minPassengers">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:comment>Min quantity of passengers in a vehicle.</rdfs:comment>
        <rdfs:label>minPassengers</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#minSpeed -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#minSpeed">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#CommDeviceCarrier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment>Min Speed of a vehicle.</rdfs:comment>
        <rdfs:label>minSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#minStrength -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#minStrength">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Min strength of a military organization.</rdfs:comment>
        <rdfs:label>minStrenght</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#modeValue -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#modeValue">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#AccessPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Mode value of an interface.</rdfs:comment>
        <rdfs:label>modeValue</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#ssid -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#ssid">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#AccessPoint"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>ssid of an interface.</rdfs:comment>
        <rdfs:label>ssid</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#strenght -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#strenght">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
        <rdfs:domain rdf:resource="https://purl.org/s2c2/miscon#MilitaryOrganization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Strenght of a military organization.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/s2c2/miscon#txPower -->

    <owl:DatatypeProperty rdf:about="https://purl.org/s2c2/miscon#txPower">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#hasQualityValue"/>
